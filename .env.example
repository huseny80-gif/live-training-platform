# ─────────────────────────────────────────────
# Database (PostgreSQL — Neon, Supabase, Railway, etc.)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"

# ─────────────────────────────────────────────
# NextAuth v5 / Auth.js
# AUTH_URL  = the full public URL of your deployment (no trailing slash)
# AUTH_SECRET = random 32-byte secret: `openssl rand -base64 32`
# ─────────────────────────────────────────────
AUTH_URL="https://your-app.vercel.app"
AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET"

# NEXTAUTH_URL is read by next.config.ts for allowedOrigins
NEXTAUTH_URL="https://your-app.vercel.app"

# ─────────────────────────────────────────────
# Public participant URL — the ONLY origin used for QR codes and join links.
# Must be a stable public production/custom domain, never a Vercel Preview URL.
# The app also fails closed to https://live-training-platform.vercel.app if an
# accidental *.vercel.app preview hostname is configured here.
# ─────────────────────────────────────────────
NEXT_PUBLIC_PARTICIPANT_URL="https://live-training-platform.vercel.app"

# ─────────────────────────────────────────────
# Session signing key for participant JWT (guest_token cookie)
# Falls back to AUTH_SECRET if not set — set explicitly for clarity
# ─────────────────────────────────────────────
SESSION_SECRET="REPLACE_WITH_RANDOM_SECRET"

# ─────────────────────────────────────────────
# AI providers
# At least ONE of OPENAI_API_KEY or ANTHROPIC_API_KEY is required.
# The same configured provider can now power PDF extraction, daily questions,
# and final questions. LLAMA_CLOUD_API_KEY remains an optional PDF fallback.
# ─────────────────────────────────────────────
# AI_PROVIDER="openai"        # optional: openai | anthropic
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-6-luna"
ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-5-5"
# ANTHROPIC_EXTRACTION_MODEL="claude-sonnet-5-5"
# ANTHROPIC_FINAL_MODEL="claude-sonnet-5-5"

# ─────────────────────────────────────────────
# Document parsing — optional secondary provider
# ─────────────────────────────────────────────
# LLAMA_CLOUD_API_KEY="llx-..."

# ─────────────────────────────────────────────
# File storage — Vercel Blob (optional; falls back to local disk)
# Required in production if you want document uploads to persist
# ─────────────────────────────────────────────
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ─────────────────────────────────────────────
# Local storage root (only used when BLOB_READ_WRITE_TOKEN is absent)
# ─────────────────────────────────────────────
# STORAGE_ROOT="/var/data/uploads"
